# ============================================================
# SUSU-BG FINTECH - Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# 
# Required variables are marked with ###
# Optional variables have default values

# ============================================================
# SERVER CONFIGURATION ###
# ============================================================
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# IMPORTANT: For Vercel Hobby plan, set BODY_LIMIT=4.5mb (hard limit ~4.5MB)

# ============================================================
# SUPABASE CONFIGURATION ###
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# JWT SECRET ### (generate with: openssl rand -hex 64)
# ============================================================
AUTH_JWT_SECRET=your-256-bit-secret-key-here-min-32-chars

# ============================================================
# ADMIN SECURITY ###
# ============================================================
ADMIN_API_KEY=admin-secret-key-for-api-access

# ============================================================
# TELLER SESSION CONFIGURATION
# ============================================================
TELLER_SESSION_EXPIRY_HOURS=8

# ============================================================
# DEMO MODE CONFIGURATION
# ============================================================
DEMO_DELAY_SECONDS=300

# ============================================================
# WIGAL SMS CONFIGURATION (Optional, for SMS/OTP)
# ============================================================
WIGAL_ENABLED=false
WIGAL_API_KEY=your-wigal-api-key
WIGAL_USERNAME=your-wigal-username
WIGAL_SENDER_ID=SUSUBG
WIGAL_OTP_EXPIRY_MINUTES=10
WIGAL_OTP_LENGTH=6

# ============================================================
# SMTP EMAIL CONFIGURATION (Optional, for receipts)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=SUSU-BG <noreply@susubg.com>
SMTP_SECURE=true

# ============================================================
# PAYMENT SETTINGS
# ============================================================

# ----- Teller (Cash) - Always enabled -----
TELLER_ENABLED=true

# ----- GhanaPay -----
GHANAPAY_ENABLED=true
GHANAPAY_MERCHANT_NUMBER=0551234567
GHANAPAY_MERCHANT_NAME=SUSU-BG FINTECH LTD

# ----- Paystack (Card Payments) -----
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ----- Mobile Money (Future) -----
MOMO_ENABLED=false

# ----- USSD (Future) -----
USSD_ENABLED=false

# ============================================================
# E-LEVY CONFIGURATION (Ghana)
# ============================================================
ELEVY_RATE=0.015
ELEVY_THRESHOLD=100
ELEVY_MIN=0.10
ELEVY_MAX=100.00

# ============================================================
# TRANSACTION FEES
# ============================================================
TX_FEE_DEPOSIT_FIXED=0.00
TX_FEE_DEPOSIT_PERCENT=0.00
TX_FEE_WITHDRAWAL_FIXED=1.00
TX_FEE_WITHDRAWAL_PERCENT=0.00

# ============================================================
# LIMITS
# ============================================================
DAILY_WITHDRAWAL_LIMIT=5000
MONTHLY_WITHDRAWAL_LIMIT=50000

# ============================================================
# BANK SETTLEMENT DETAILS
# ============================================================
SETTLEMENT_BANK_NAME=GCB Bank
SETTLEMENT_ACCOUNT_NUMBER=123456789
SETTLEMENT_ACCOUNT_NAME=SUSU-BG FINTECH LTD

# ============================================================
# DEFAULT CURRENCY
# ============================================================
DEFAULT_CURRENCY=GHS

# ============================================================
# FRONTEND URL (for callbacks/webhooks)
# ============================================================
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# ============================================================
# VERCEL-SPECIFIC
# ============================================================
# BODY_LIMIT=4.5mb
# ELEVY_RATE=0.005
# ELEVY_THRESHOLD=100